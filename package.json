{
  "name": "@mylesb/oxlint-config",
  "version": "0.0.0-development",
  "description": "Myles' shared oxlint configuration for (hopefully) all his projects.",
  "keywords": [
    "oxlint",
    "oxlint-config"
  ],
  "license": "MIT",
  "author": "Myles Braithwaite <myles@myles.garden> (https://myles.garden)",
  "repository": {
    "type": "git",
    "url": "git@github.com:myles/oxlint-config.git"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "oxlintrc.json"
  ],
  "type": "module",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./oxlintrc.json": "./oxlintrc.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "oxfmt": "oxfmt --check",
    "oxfmt:write": "oxfmt --write",
    "oxlint": "oxlint",
    "oxlint:fix": "oxlint --fix",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@mylesb/oxfmt-config": "^1.0.0",
    "oxfmt": "^0.72.0",
    "oxlint": "1.80.0"
  },
  "peerDependencies": {
    "oxlint": ">=1.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
